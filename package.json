{
  "name": "tlock-js",
  "version": "1.0.0",
  "description": "Timelock encryption using drand and age",
  "license": "(Apache-2.0 OR MIT)",
  "author": "drand.love",
  "repository": "github:drand/tlock-js",
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "packageManager": "bun@1.4.5",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/types.d.ts",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --target browser --format esm --packages external --outfile ./dist/index.js && bun run tsc -p tsconfig.build.json",
    "test:go": "bun run test/go-interop.ts",
    "test:live": "bun run test/live.ts",
    "test:package": "bun run test/package.ts"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "drand-client": "1.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
